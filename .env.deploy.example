# Use a random hexadecimal password (no URL-encoding needed).
DB_PASSWORD=replace-with-random-hex
SEED_PASSWORD=replace-with-a-long-random-password
# Host directory for PostgreSQL data. Relative paths are resolved from the project directory.
DB_DATA_DIR=./data/postgres
APP_PORT=3100
APP_ORIGIN=http://localhost:3100
# false is only for local HTTP; HTTPS deployments must use true.
COOKIE_SECURE=false
# For the optional HTTPS overlay; set a real domain pointing to the server.
SITE_ADDRESS=station.example.com
